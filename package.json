{
  "name": "ascent-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ascent \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "firebase-tools": "14.27.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
