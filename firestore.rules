rules_version = '2';

// Security rules for The Ascent.
// Access comes from one allowlist document, config/access:
//   { admins: [emails], members: [emails] }   (lowercase Google emails)
// - Signed-out visitors and accounts not on the list: no reads, no writes.
// - Members: read everything, tick/untick steps (progress), update meta/milestones.
// - Admins: everything members can do, plus edit goals, steps and config/access.
service cloud.firestore {
  match /databases/{database}/documents {

    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && exists(accessPath()) && email() in get(accessPath()).data.admins;
    }

    function isMember() {
      return signedIn() && exists(accessPath())
        && (email() in get(accessPath()).data.members || email() in get(accessPath()).data.admins);
    }

    function text(v, max) {
      return v is string && v.size() <= max;
    }

    function smallNumber(v) {
      return (v is int || v is float) && v >= 0 && v <= 1000;
    }

    function isDateKey(m, k) {
      return !(k in m) || (m[k] is string && m[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    function milestoneMap(d, field) {
      return !(field in d) || (
        d[field] is map
        && d[field].keys().hasOnly(['m1', 'm2', 'm3'])
        && isDateKey(d[field], 'm1') && isDateKey(d[field], 'm2') && isDateKey(d[field], 'm3')
      );
    }

    // Steps go in order: step n can only be ticked once step n-1 is done.
    function previousStepDone(stepId) {
      let parts = stepId.split('s');
      let n = int(parts[1]);
      return n == 1 || exists(/databases/$(database)/documents/progress/$(parts[0] + 's' + string(n - 1)));
    }

    match /config/access {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['admins', 'members'])
        && request.resource.data.keys().hasAll(['admins', 'members'])
        && request.resource.data.admins is list && request.resource.data.admins.size() <= 50
        && request.resource.data.members is list && request.resource.data.members.size() <= 50;
    }

    match /goals/{goalId} {
      allow read: if isMember();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && goalId.size() <= 20
        && request.resource.data.keys().hasOnly(['order', 'name', 'goal', 'meaning'])
        && request.resource.data.keys().hasAll(['order', 'name', 'goal', 'meaning'])
        && smallNumber(request.resource.data.order)
        && text(request.resource.data.name, 80)
        && text(request.resource.data.goal, 120)
        && text(request.resource.data.meaning, 300);
    }

    match /steps/{stepId} {
      allow read: if isMember();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && stepId.size() <= 20
        && request.resource.data.keys().hasOnly(['goal', 'order', 't'])
        && request.resource.data.keys().hasAll(['goal', 'order', 't'])
        && text(request.resource.data.goal, 20)
        && smallNumber(request.resource.data.order)
        && text(request.resource.data.t, 300);
    }

    match /progress/{stepId} {
      allow read: if isMember();
      allow delete: if isMember();
      allow create, update: if isMember()
        && stepId.matches('g[0-9]+s[0-9]+')
        && request.resource.data.keys().hasOnly(['goal', 'at', 'by'])
        && request.resource.data.keys().hasAll(['goal', 'at', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.goal == stepId.split('s')[0]
        && text(request.resource.data.at, 40)
        && previousStepDone(stepId);
    }

    match /meta/milestones {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['reached', 'celebrated'])
        && milestoneMap(request.resource.data, 'reached')
        && milestoneMap(request.resource.data, 'celebrated');
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
