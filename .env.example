# Copy to .env.local for local development, or add the same names in
# Vercel → Project → Settings → Environment Variables (Production and Preview).
# Values: Firebase console → Project settings → Your apps → Web app → SDK config.
# Firebase web API keys are not secrets; the Firestore security rules protect the data.
# Leave these empty to run in "Saved on this device only" mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
